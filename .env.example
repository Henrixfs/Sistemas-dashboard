# Application
ENVIRONMENT=development
API_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Database
DATABASE_URL=postgresql://epis_user:change-me@localhost:5432/epis_transparente
POSTGRES_DB=epis_transparente
POSTGRES_USER=epis_user
# Desarrollo local solamente; use un secreto distinto fuera de este entorno.
POSTGRES_PASSWORD=replace-with-a-local-development-password
FRONTEND_PORT=3000

# Sessions (reserved for the authentication block)
SESSION_SECRET=replace-with-a-long-random-value
SESSION_IDLE_TIMEOUT_MINUTES=30

# Private voucher storage (reserved for the voucher block)
STORAGE_PATH=./storage/vouchers
